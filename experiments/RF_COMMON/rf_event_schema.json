{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WellPulse RF Capability Smoke Event",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "platform",
    "event_type",
    "utc_timestamp"
  ],
  "properties": {
    "schema_version": {"const": "wp-rf-event-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "platform": {"enum": ["POWDER", "COSMOS_ORBIT", "ARA", "OTHER"]},
    "resource_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "event_type": {
      "enum": [
        "RUN_START",
        "RUN_END",
        "RF_STATE",
        "RF_METRIC",
        "APP_RECORD",
        "APP_RECONNECT",
        "BACKLOG_DRAIN_COMPLETE",
        "FAULT",
        "NOTE"
      ]
    },
    "architecture": {"enum": ["B0", "W1", "NA"]},
    "rf_state": {"enum": ["R0", "R1", "R2", "NA"]},
    "utc_timestamp": {"type": "string", "format": "date-time"},
    "monotonic_seconds": {"type": "number", "minimum": 0},
    "boot_id": {"type": ["string", "null"]},
    "sequence": {"type": ["integer", "null"], "minimum": 0},
    "control_action": {"type": ["string", "null"]},
    "requested_value": {"type": ["number", "string", "null"]},
    "observed_value": {"type": ["number", "string", "null"]},
    "metric_name": {
      "enum": [
        "RSRP",
        "RSRQ",
        "SINR",
        "RSSI",
        "ATTENUATION",
        "THROUGHPUT",
        "PACKET_DELIVERY",
        "LATENCY",
        "JITTER",
        "LINK_STATE",
        "OTHER",
        "NA"
      ]
    },
    "metric_value": {"type": ["number", "string", "null"]},
    "metric_unit": {"type": ["string", "null"]},
    "payload_checksum": {"type": ["string", "null"]},
    "details": {"type": "object", "additionalProperties": true}
  },
  "additionalProperties": false
}
