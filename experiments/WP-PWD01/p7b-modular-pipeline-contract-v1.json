  "manual_steps": [
    {
      "id": "R0",
      "name": "POWDER_RESERVATION",
      "when": "AFTER_H2_PASS_AND_SEPARATE_EXPLICIT_LIVE_AUTHORIZATION",
      "actor": "USER",
      "action": "CREATE_OR_SELECT_RESERVATION_IN_POWDER_PORTAL",
      "outputs": ["experiment_id", "experiment_name"],
      "github_reservation_creation": false
    },
    {
      "id": "T0",
      "name": "POWDER_TEARDOWN",
      "when": "ONLY_AFTER_TEARDOWN_READY_YES",
      "actor": "USER",
      "action": "TERMINATE_RESERVATION_IN_POWDER_PORTAL",
      "preconditions": [
        "M10_PASS",
        "ALL_REQUIRED_EVIDENCE_READBACK_GATES_PASS"
      ],
      "automatic_teardown": false
    }
  ],
  "h2_offline_modules": [
    {"id": "H2.1", "gate": "H2_1_CONTRACT_DELTA=PASS", "weight_pct": 20},
    {"id": "H2.2", "gate": "H2_2_SESSION_OWNERSHIP=PASS", "weight_pct": 20},
    {"id": "H2.3", "gate": "H2_3_FRONTIER_EVIDENCE=PASS", "weight_pct": 15},
    {"id": "H2.4", "gate": "H2_4_ADVERSARIAL_QA=PASS", "weight_pct": 20},
    {"id": "H2.5", "gate": "H2_5_REGRESSION=PASS", "weight_pct": 15},
    {"id": "H2.6", "gate": "WP2_P7B_H2=PASS_OR_BLOCKED", "weight_pct": 10}
  ],
  "live_modules": [
    {
      "id": "M0",
      "display_name": "00 Freeze",
      "mode": "NO_POWDER_CONTACT",
      "purpose": "freeze one-shot authority and immutable session contract",
      "required_gate": "M0_SESSION_FREEZE=PASS"
    },
    {
      "id": "M1",
      "display_name": "10 EFCC",
      "mode": "POWDER_READ_ONLY",
      "purpose": "reservation identity, manifest, endpoints, environment-first delta census",
      "required_gate": "M1_EFCC_DELTA=PASS"
    },
    {
      "id": "M2",
      "display_name": "20 Preflight",
      "mode": "READ_ONLY_TARGET_PREFLIGHT",
      "purpose": "controller/service-session disjointness, path, parser and target-runtime proof",
      "required_gates": [
        "CONTROLLER_SERVICE_SESSION_DISJOINTNESS=PASS",
        "M2_TARGET_PREFLIGHT=PASS"
      ]
    },
    {
      "id": "M3",
      "display_name": "30 Q0 Baseline",
      "mode": "LIVE_BASELINE_PREPARATION",
      "purpose": "establish exact known-good Q0 service/user-plane baseline with H2-safe ownership logic",
      "required_gate": "M3_Q0_BASELINE=PASS"
    },
    {
      "id": "M4",
      "display_name": "40 B1",
      "mode": "SCIENTIFIC_CELL",
      "cell": "P7B-B1-S3",
      "required_gate": "M4_B1_MECHANICS=PASS",
      "scientific_performance_is_orchestration_gate": false
    },
    {
      "id": "M5",
      "display_name": "45 B1 Evidence",
      "mode": "EVIDENCE_SURVIVAL",
      "runs_after": "M4_ALWAYS",
      "required_gate": "M5_B1_EVIDENCE=PASS",
      "failure_action": "LEAVE_EXPERIMENT_LIVE_AND_STOP"
    },
    {
      "id": "M6",
      "display_name": "60 W1",
      "mode": "SCIENTIFIC_CELL",
      "cell": "P7B-W1-S3",
      "required_gate": "M6_W1_MECHANICS=PASS",
      "scientific_performance_is_orchestration_gate": false
    },
    {
      "id": "M7",
      "display_name": "65 W1 Evidence",
      "mode": "EVIDENCE_SURVIVAL",
      "runs_after": "M6_ALWAYS",
      "required_gate": "M7_W1_EVIDENCE=PASS",
      "failure_action": "LEAVE_EXPERIMENT_LIVE_AND_STOP"
    },
    {
      "id": "M8",
      "display_name": "80 B2",
      "mode": "SCIENTIFIC_CELL",
      "cell": "P7B-B2-S3",
      "required_gate": "M8_B2_MECHANICS=PASS",
      "scientific_performance_is_orchestration_gate": false
    },
    {
      "id": "M9",
      "display_name": "85 B2 Evidence",
      "mode": "EVIDENCE_SURVIVAL",
      "runs_after": "M8_ALWAYS",
      "required_gate": "M9_B2_EVIDENCE=PASS",
      "failure_action": "LEAVE_EXPERIMENT_LIVE_AND_STOP"
    },
    {
      "id": "M10",
      "display_name": "95 Reconstruct",
      "mode": "NO_NEW_SCIENTIFIC_MUTATION",
      "purpose": "contract reconstruction, generated-vs-received reconciliation and non-scored qualification verdict",
      "terminal_verdicts": [
        "WP2_P7B_REQUALIFICATION=PASS_NON_SCORED_PHYSICAL_QUALIFICATION",
        "WP2_P7B_REQUALIFICATION=BLOCKED:<first-cause>"
      ],
      "pass_outputs": [
        "TEARDOWN_READY=YES",
        "SCORED_AUTHORIZATION=NO",
        "WP3_AUTHORIZATION=NO"
      ]
    },
    {
      "id": "M99",
      "display_name": "99 Session Summary",
      "mode": "HCI_ONLY",
      "runs": "ALWAYS",
      "authoritative_scientific_data": false
    }
  ],
  "dependencies": [
