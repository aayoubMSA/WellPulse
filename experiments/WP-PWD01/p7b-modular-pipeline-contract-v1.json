    "workflow_creation_policy": "CREATE_ONLY_AFTER_H2_PASS_AND_SEPARATE_EXPLICIT_USER_LIVE_AUTHORIZATION",
    "workflow_retirement_policy": "RETIRE_AFTER_TERMINAL_SESSION_CLOSURE",
