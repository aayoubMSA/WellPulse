    "scientific_contract": "experiments/WP-PWD01/p7b-executable-contract-v2.json",
    "workflow_design": "docs/WP2_P7B_MODULAR_EXECUTION_ARCHITECTURE_2026-08-28.md",
    "experience_ledger": "Research & Grants — Lessons Learned Ledger"
  },
  "architecture": {
    "live_entry_surfaces": 1,
    "future_workflow": ".github/workflows/wp2-p7b-rq2-session.yml",
