    "STOP_FOR_EXPLICIT_LIVE_AUTHORIZATION",
    "USER_CREATES_OR_SELECTS_POWDER_RESERVATION",
    "CREATE_SINGLE_EPHEMERAL_MANUAL_DISPATCH_WORKFLOW",
    "EXECUTE_EXACTLY_ONE_FIRST_ATTEMPT_RUN",
    "STOP_AT_TEARDOWN_READY",
